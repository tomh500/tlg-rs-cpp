{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64 /std:c++latest",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": { "BUILD_TESTING": "ON", "TLG_BUILD_BENCHMARKS": "ON" }
    },
    {
      "name": "msvc-asan",
      "inherits": "msvc",
      "binaryDir": "${sourceDir}/build/msvc-asan",
      "cacheVariables": { "TLG_ENABLE_SANITIZERS": "ON", "TLG_BUILD_BENCHMARKS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "debug", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "asan", "configurePreset": "msvc-asan", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "msvc", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "msvc-asan", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } }
  ]
}
