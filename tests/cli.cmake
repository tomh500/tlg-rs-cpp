file(SHA256 "${WORK}/轩酱.raw" before)
file(SHA256 "${WORK}/轩酱还原.raw" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unicode CLI roundtrip changed pixels")
endif()
execute_process(COMMAND "${TOOL}" decode "${WORK}/5.tlg" "${WORK}/5.tlg"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "CLI did not reject overwriting its input")
endif()
file(SHA256 "${WORK}/input.raw" before)
execute_process(COMMAND "${TOOL}" encode --width 0 --height 2 --layout rgb
    "${WORK}/input.raw" "${WORK}/input.raw" RESULT_VARIABLE result ERROR_VARIABLE error)
file(SHA256 "${WORK}/input.raw" after)
if(NOT result EQUAL 2 OR NOT before STREQUAL after)
    message(FATAL_ERROR "invalid arguments changed the input")
endif()

function(run_tool)
    execute_process(COMMAND "${TOOL}" ${ARGV}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CLI command ${ARGV} failed: ${output}${error}")
    endif()
    set(tool_output "${output}" PARENT_SCOPE)
endfunction()

function(compare_pixels original restored)
    file(SHA256 "${original}" original_hash)
    file(SHA256 "${restored}" restored_hash)
    if(NOT original_hash STREQUAL restored_hash)
        message(FATAL_ERROR "image conversion changed pixels: ${original} -> ${restored}")
    endif()
endfunction()

foreach(profile reference optimized compact)
    foreach(version 5 6)
        run_tool(transcode --profile ${profile} --format ${version} --refine-work 4096
            "${WORK}/6.tlg" "${WORK}/${profile}-${version}.tlg")
        run_tool(decode --profile ${profile} "${WORK}/${profile}-${version}.tlg" "${WORK}/${profile}-${version}.raw")
        compare_pixels("${WORK}/input.raw" "${WORK}/${profile}-${version}.raw")
        run_tool(info "${WORK}/${profile}-${version}.tlg")
        if(NOT tool_output MATCHES "a,b:c=d")
            message(FATAL_ERROR "profile ${profile} lost metadata")
        endif()
    endforeach()
endforeach()
# A later profile must clear compact's whole-file comparison flag too.
run_tool(transcode --profile compact --profile optimized --slide-memory 1
    "${WORK}/6.tlg" "${WORK}/reset-profile.tlg")

run_tool(--version)
if(NOT tool_output MATCHES "tlg_tool [0-9]+\\.[0-9]+\\.[0-9]+")
    message(FATAL_ERROR "version did not identify the tool: ${tool_output}")
endif()
run_tool(detect "${WORK}/5.tlg")
if(NOT tool_output MATCHES "SDS TLG5")
    message(FATAL_ERROR "detect did not recognize SDS TLG5: ${tool_output}")
endif()
run_tool(detect "${CMAKE_CURRENT_LIST_DIR}/fixtures/rgb_9x11_gradient.tlg6")
if(NOT tool_output MATCHES "TLG6")
    message(FATAL_ERROR "detect did not recognize raw TLG6: ${tool_output}")
endif()
file(WRITE "${WORK}/short" "P5")
execute_process(COMMAND "${TOOL}" detect "${WORK}/short"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT output MATCHES "not TLG")
    message(FATAL_ERROR "short non-TLG detection failed: ${output}${error}")
endif()

run_tool(transcode --version 6 --slide-parse greedy --slide-match primary --filter-search reference
    --slide-decode scalar --tag "extra=kept" "${WORK}/5.tlg" "${WORK}/transcoded.tlg")
run_tool(info "${WORK}/transcoded.tlg")
if(NOT tool_output MATCHES "TLG6" OR NOT tool_output MATCHES "a,b:c=d" OR NOT tool_output MATCHES "kept")
    message(FATAL_ERROR "transcode lost metadata: ${tool_output}")
endif()
run_tool(decode --slide-decode scalar "${WORK}/transcoded.tlg" "${WORK}/transcoded.raw")
compare_pixels("${WORK}/input.raw" "${WORK}/transcoded.raw")
run_tool(encode -v 5 --slide-parse optimal --slide-match adaptive --slide-memory 16777216
    --tag "note=replaced" "${WORK}/transcoded.tlg" "${WORK}/optimal.tlg")
run_tool(info "${WORK}/optimal.tlg")
if(NOT tool_output MATCHES "replaced" OR NOT tool_output MATCHES "kept")
    message(FATAL_ERROR "encode from TLG did not replace and retain metadata: ${tool_output}")
endif()
run_tool(decode "${WORK}/optimal.tlg" "${WORK}/optimal.raw")
compare_pixels("${WORK}/input.raw" "${WORK}/optimal.raw")
foreach(profile reference optimized)
    run_tool(encode --profile ${profile} --format 6 "${WORK}/transcoded.tlg" "${WORK}/${profile}.tlg")
    run_tool(decode --profile ${profile} "${WORK}/${profile}.tlg" "${WORK}/${profile}.raw")
    compare_pixels("${WORK}/input.raw" "${WORK}/${profile}.raw")
endforeach()
compare_pixels("${WORK}/reference.tlg" "${WORK}/optimized.tlg")

# The first few bytes intentionally look like header whitespace and a comment.
# Header parsing must stop before the raster, even when the image is tiny.
file(WRITE "${WORK}/tiny-gray.raw" "\t #a")
file(WRITE "${WORK}/tiny-gray.pgm" "P5\n# comment\n4 1\n255\n\t #a")
run_tool(encode "${WORK}/tiny-gray.pgm" "${WORK}/tiny-gray.tlg")
run_tool(decode "${WORK}/tiny-gray.tlg" "${WORK}/tiny-gray-restored.raw")
compare_pixels("${WORK}/tiny-gray.raw" "${WORK}/tiny-gray-restored.raw")
run_tool(decode "${WORK}/tiny-gray.tlg" "${WORK}/tiny-gray-out.pgm")
run_tool(encode "${WORK}/tiny-gray-out.pgm" "${WORK}/tiny-gray-again.tlg")
run_tool(decode "${WORK}/tiny-gray-again.tlg" "${WORK}/tiny-gray-again.raw")
compare_pixels("${WORK}/tiny-gray.raw" "${WORK}/tiny-gray-again.raw")

