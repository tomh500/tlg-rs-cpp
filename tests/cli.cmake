file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/input.raw" "abcdefghijklmnopqrstuvwx")
foreach(version 5 6)
    execute_process(COMMAND "${TOOL}" encode --format ${version} --width 4 --height 2
        --layout rgb --tag "note=a,b:c=d" "${WORK}/input.raw" "${WORK}/${version}.tlg"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "encode failed: ${output}${error}")
    endif()
    execute_process(COMMAND "${TOOL}" decode "${WORK}/${version}.tlg" "${WORK}/${version}.raw"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "decode failed: ${output}${error}")
    endif()
    file(SHA256 "${WORK}/input.raw" before)
    file(SHA256 "${WORK}/${version}.raw" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "CLI roundtrip changed pixels")
    endif()
    execute_process(COMMAND "${TOOL}" info "${WORK}/${version}.tlg"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "TLG${version} 4x2 3 channels" OR NOT output MATCHES "a,b:c=d")
        message(FATAL_ERROR "incorrect info: ${output}${error}")
    endif()
endforeach()
file(WRITE "${WORK}/轩酱.raw" "abcdefghijklmnopqrstuvwx")
execute_process(COMMAND "${TOOL}" encode --width 4 --height 2 --layout rgb
    --tag "作者=轩酱,:=中文" "${WORK}/轩酱.raw" "${WORK}/轩酱.tlg"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unicode input/metadata failed: ${output}${error}")
endif()
execute_process(COMMAND "${TOOL}" info "${WORK}/轩酱.tlg"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
if(NOT result EQUAL 0 OR NOT output MATCHES "轩酱,:=中文")
    message(FATAL_ERROR "Unicode info failed: ${output}${error}")
endif()
execute_process(COMMAND "${TOOL}" decode "${WORK}/轩酱.tlg" "${WORK}/轩酱还原.raw"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Unicode output failed: ${output}${error}")
endif()
file(SHA256 "${WORK}/轩酱.raw" before)
file(SHA256 "${WORK}/轩酱还原.raw" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Unicode CLI roundtrip changed pixels")
endif()
execute_process(COMMAND "${TOOL}" decode "${WORK}/5.tlg" "${WORK}/5.tlg"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "CLI did not reject overwriting its input")
endif()
file(SHA256 "${WORK}/input.raw" before)
execute_process(COMMAND "${TOOL}" encode --width 0 --height 2 --layout rgb
    "${WORK}/input.raw" "${WORK}/input.raw" RESULT_VARIABLE result ERROR_VARIABLE error)
file(SHA256 "${WORK}/input.raw" after)
if(NOT result EQUAL 2 OR NOT before STREQUAL after)
    message(FATAL_ERROR "invalid arguments changed the input")
endif()
